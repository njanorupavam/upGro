generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks  Task[]
  habits Habit[]
  goals  Goal[]
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userId      String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([priority])
}

model Habit {
  id            String  @id @default(cuid())
  title         String
  description   String?
  currentStreak Int     @default(0)
  bestStreak    Int     @default(0)
  userId        String

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIns HabitCheckIn[]

  @@index([userId])
}

model HabitCheckIn {
  id        String   @id @default(cuid())
  date      DateTime
  createdAt DateTime @default(now())
  habitId   String

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId])
  @@index([date])
}

model Goal {
  id          String    @id @default(cuid())
  title       String
  description String?
  targetDate  DateTime?
  progress    Int       @default(0)
  userId      String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
